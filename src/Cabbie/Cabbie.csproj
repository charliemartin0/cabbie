<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Cabbie</PackageId>
    <Description>Wolverine-shaped in-process message bus kernel for .NET: handler discovery, cascading messages, sagas, error policies, local queues and in-memory stores.</Description>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Internal API (CachedInvoker, HandlerInvoker) must be readable by the test project. -->
    <InternalsVisibleTo Include="Cabbie.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Domain\Sagas\Validators\" />
  </ItemGroup>

</Project>
