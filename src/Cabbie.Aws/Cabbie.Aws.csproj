<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>Cabbie.Aws</PackageId>
    <Description>Amazon SQS and SNS transports for Cabbie.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cabbie\Cabbie.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="4.0.100.19" />
    <PackageReference Include="AWSSDK.SQS" Version="4.0.100.18" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Cabbie.Aws.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
