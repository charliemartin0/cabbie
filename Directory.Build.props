<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Enables the Recommended .NET analyzer rule set. Existing violations are baselined as
         "suggestion" in .editorconfig; every other rule is enforced via TreatWarningsAsErrors. -->
    <AnalysisMode>Recommended</AnalysisMode>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- NuGet metadata shared by every shippable project. Projects under src/ opt in with
       IsPackable=true, a PackageId and a Description; tests and samples stay unpackable. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <Version>0.1.0</Version> <!-- x-release-please-version -->
    <Authors>Charlie Martin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/charliemartin0/cabbie</PackageProjectUrl>
    <RepositoryUrl>https://github.com/charliemartin0/cabbie</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>messaging;message-bus;saga;outbox;scheduler</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
